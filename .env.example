# --- Required ---
DATABASE_URL=            # Neon connection string (same DB as Case 02 is fine; tables are prefixed aangan_)
GEMINI_API_KEY=          # one or more comma-separated keys; use a billed key so call data isn't used for training
GEMINI_MODEL=gemini-3.6-flash
DASHBOARD_PASSWORD=      # leave empty to run the dashboard without a login
APP_URL=http://localhost:3000   # the deployed https URL once on Vercel (used in links and the Telegram webhook)

# --- Vaani Labs (voice agent) - when API access arrives ---
VAANI_WEBHOOK_SECRET=    # vv_whk_... signing secret of the call.completed webhook

# --- Telegram (designer alerts) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_DESIGNERS_CHAT_ID=
TELEGRAM_ESCALATION_CHAT_ID=   # Nikhil's chat; falls back to the designers' group
TELEGRAM_WEBHOOK_SECRET=       # any random string; protects the button-click endpoint

# --- HubSpot (CRM) ---
HUBSPOT_TOKEN=           # private-app token: contacts + deals read/write

# --- Cal.com (booking) ---
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_ATTENDEE_EMAIL=   # studio inbox used as the attendee email (callers rarely give one)

# --- Generic ingest endpoint (POST /api/calls) ---
INGEST_SECRET=
TOOLS_SECRET=            # bearer token the Vaani custom tools send (Authorization: Bearer ...)

# --- Optional rate overrides ---
# VOICE_INR_PER_MIN=5.6
# GEMINI_USD_PER_M_INPUT=0.75
# GEMINI_USD_PER_M_OUTPUT=3.75
# USD_INR=88
# CLAIM_SLA_MINUTES=30
